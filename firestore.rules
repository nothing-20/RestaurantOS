rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper to check if user profile document exists
    function userExists() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper to get user profile data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check role matching safely
    function hasRole(role) {
      return userExists() && getUserData().get('role', '') == role;
    }

    // Helper to check tenant alignment safely
    function isTenant(tenantId) {
      return tenantId != null && userExists() && getUserData().get('tenantId', '') == tenantId;
    }

    // Global settings & system features
    match /systemSettings/{settingsId} {
      allow read: if isAuth();
      allow write: if hasRole('super-admin');
    }

    match /featureFlags/{flagId} {
      allow read: if isAuth();
      allow write: if hasRole('super-admin');
    }

    // Customer support ticketing
    match /supportTickets/{ticketId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if hasRole('super-admin');
    }

    // Audit logs - Immutable audit logs protection
    match /auditLogs/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false; // Immutable protection
    }

    // Root-level User accounts (restaurant staff and owners)
    // A user can read user profiles when authenticated.
    // Avoid calling getUserData() or helper functions here to prevent recursive rule evaluation.
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        request.auth.uid == userId ||
        request.auth.token.role == 'super-admin'
      );

      match /{subcollection}/{docId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // Root-level Customer accounts (diner profiles, strictly isolated by UID)
    match /customers/{customerUid} {
      allow read: if isAuth() && (
        request.auth.uid == customerUid ||
        request.auth.token.role == 'super-admin' ||
        getUserData().get('role', '') in ['super-admin', 'admin']
      );
      allow write: if isAuth() && (
        request.auth.uid == customerUid ||
        request.auth.token.role == 'super-admin' ||
        getUserData().get('role', '') in ['super-admin', 'admin']
      );

      // Customer reservations subcollection: customer can read/write; restaurant staff can update reservation status
      match /reservations/{reservationId} {
        allow read: if isAuth() && (
          request.auth.uid == customerUid ||
          request.auth.token.role == 'super-admin' ||
          getUserData().get('role', '') in ['super-admin', 'admin']
        );
        allow write: if isAuth() && (
          request.auth.uid == customerUid ||
          request.auth.token.role == 'super-admin' ||
          userExists()
        );
      }

      // Customer private subcollections (addresses, transactions, diningHistory, notifications, orders)
      match /{subcollection}/{docId} {
        allow read, write: if isAuth() && (
          request.auth.uid == customerUid ||
          request.auth.token.role == 'super-admin' ||
          getUserData().get('role', '') in ['super-admin', 'admin']
        );
      }
    }

    // Root-level Employee invitation records
    // Individual document fetch: allowed if authenticated OR if fetching a pending invitation by exact ID.
    // Collection listing/querying: strictly restricted to authenticated staff to prevent enumeration of pending invitations.
    match /employees/{employeeId} {
      allow get: if isAuth() || resource.data.activationStatus in ['invited', 'activated'];
      allow list: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // Tenants base metadata profiles (Public read for customer discovery)
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Merchant Restaurant hierarchy (scoping subcollections)
    match /restaurants/{tenantId} {
      allow read: if true;
      allow write: if isAuth();

      // Public & Customer readable subcollections (branches, tables)
      match /branches/{branchId} {
        allow read: if true;
        allow write: if isAuth();
      }

      match /tables/{tableId} {
        allow read: if true;
        allow write: if isAuth();
      }

      // Customer Orders - read/create by customers or tenant staff, write by authorized staff
      match /orders/{orderId} {
        allow read: if true;
        allow create: if true;
        allow update: if isAuth();
        allow delete: if isAuth();
      }

      // Customer Service Requests & Dining Sessions
      match /waiterRequests/{reqId} {
        allow read: if true;
        allow create: if true;
        allow update: if isAuth();
      }

      match /requests/{reqId} {
        allow read: if true;
        allow create: if true;
        allow update: if isAuth();
      }

      match /diningSessions/{sessionId} {
        allow read, create, update: if true;
      }

      // Specific rule to match nested menu subcollections (categories, items, variants, addons)
      match /menu/{menuDoc}/{nestedSubcollection}/{nestedDocId} {
        allow read: if true;
        allow write: if isAuth();
      }

      // Universal rule for other management subcollections inside tenant workspace
      match /{subcollection}/{docId} {
        allow read: if isAuth() && (isTenant(tenantId) || getUserData().get('role', '') in ['super-admin', 'owner', 'admin']);
        allow write: if isAuth();
      }
    }
  }
}
